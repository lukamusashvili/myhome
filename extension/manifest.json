{
  "manifest_version": 3,
  "name": "AgentOS Extension",
  "version": "1.1.1",
  "description": "Connects AgentOS to your MyHome.ge and SS.ge accounts so you can import and publish listings.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.tnet.ge/*",
    "*://*.myhome.ge/*",
    "*://*.my.ge/*",
    "*://*.ss.ge/*",
    "https://res.cloudinary.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AgentOS",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://agentos.ge/*",
      "https://portal.agentos.ge/*",
      "http://localhost:5173/*"
    ]
  }
}
